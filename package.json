{
  "name": "erp-arpia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ERP Arpia — Sistema de gestión integral",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:real": "cross-env USE_MOCK=false tsx server.ts",
    "dev:all": "pwsh -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "dev:all:prod": "pwsh -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Mode prod",
    "dev:all:docker": "pwsh -ExecutionPolicy Bypass -File scripts/start-all.ps1 -UseDockerApi",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "start:real": "cross-env USE_MOCK=false node dist/server.mjs",
    "start:mock": "cross-env USE_MOCK=true node dist/server.mjs",
    "start:all": "pwsh -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Mode prod",
    "start:all:docker": "pwsh -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Mode prod -UseDockerApi",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "echarts": "^5.6.0",
    "express": "^4.21.2",
    "pinia": "^3.0.1",
    "primeicons": "^8.0.0",
    "primevue": "4.5.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
