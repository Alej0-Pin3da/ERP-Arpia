# Database (REQUIRED - no defaults for production)
DATABASE_URL=postgresql+psycopg://arpia:CHANGE_ME@db:5432/arpia
POSTGRES_DB=arpia
POSTGRES_USER=arpia
POSTGRES_PASSWORD=CHANGE_ME
DB_PORT=5432

# JWT (REQUIRED - no defaults for production)
JWT_SECRET_KEY=CHANGE_ME_USE_SECURE_RANDOM_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Environment
ENVIRONMENT=development

# CORS (REQUIRED for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tokens (defaults match backend/app/core/config.py)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / queue (defaults to local; override in prod if used)
REDIS_URL=redis://localhost:6379/0

# WooCommerce webhooks V6 M3 (empty = endpoint disabled)
WOO_WEBHOOK_SECRET=

# Local LLM commercial copy V6 M5 (Ollama; NOT available on shared hosting)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=60

# Backend API (REAL-only — the in-memory mock was removed)
# The frontend and server.ts always proxy /api to the real FastAPI backend.
# Backend + Postgres must be running (see docker-compose.yml).
# API_PROXY_TARGET=http://localhost:8000
# VITE_API_BASE_URL=/api/v1