{
  "name": "erp-arpia-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ERP Arpia frontend — Vue 3 SPA (Phase 6, frontend-dashboard)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src/ tests/",
